<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         IgnorableNamespaces="desktop rescap uap uap10">
    <Identity ProcessorArchitecture="x64" />
    <Properties>
        <DisplayName>FreezeCut</DisplayName>
        <PublisherDisplayName />
        <Logo>Assets\StoreLogo.png</Logo>
    </Properties>
    <Resources>
        <Resource Language="en-US" />
    </Resources>
    <Dependencies>
        <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    </Dependencies>
    <Applications>
        <Application Id="FreezeCut" Executable="bin\FreezeCutGUI.exe" EntryPoint="Windows.FullTrustApplication">
            <uap:VisualElements DisplayName="FreezeCut" Description="Capture, annotate, and keep screenshots."
                                BackgroundColor="transparent" Square44x44Logo="Assets\Square44x44Logo.png"
                                Square150x150Logo="Assets\Square150x150Logo.png" />
            <Extensions>
                <desktop:Extension Category="windows.startupTask" Executable="bin\FreezeCutGUI.exe"
                                   EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--tray">
                    <desktop:StartupTask TaskId="FreezeCutStartup" Enabled="false" DisplayName="FreezeCut" />
                </desktop:Extension>
            </Extensions>
        </Application>
    </Applications>
    <Capabilities>
        <rescap:Capability Name="runFullTrust" />
    </Capabilities>
</Package>
