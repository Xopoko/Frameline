[Desktop Entry]
Type=Application
Name=Frameline
Comment=Take and annotate screenshots
Exec=frameline
Icon=io.github.xopoko.Frameline
Terminal=false
Categories=Graphics;
StartupNotify=true
Actions=Full;Region;

[Desktop Action Full]
Name=Capture screen
Exec=frameline capture full

[Desktop Action Region]
Name=Capture region
Exec=frameline capture region
