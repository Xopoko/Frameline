[Desktop Entry]
Type=Application
Name=ScreenFrame
Comment=Take and annotate screenshots
Exec=screenframe
Icon=io.github.xopoko.ScreenFrame
Terminal=false
Categories=Graphics;
StartupNotify=true
Actions=Full;Region;

[Desktop Action Full]
Name=Capture screen
Exec=screenframe capture full

[Desktop Action Region]
Name=Capture region
Exec=screenframe capture region
